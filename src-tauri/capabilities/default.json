{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "主窗口：完整业务入口，子窗口使用独立最小权限。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-get-bootstrap",
    "allow-complete-onboarding",
    "allow-get-board",
    "allow-get-heatmap",
    "allow-get-day-completions",
    "allow-set-task-done",
    "allow-undo-last",
    "allow-set-appearance",
    "allow-window-ready",
    "allow-submit-input",
    "allow-confirm-pending",
    "allow-cancel-pending",
    "allow-stop-input",
    "allow-list-inbox",
    "allow-retry-inbox",
    "allow-discard-inbox",
    "allow-get-model-settings",
    "allow-get-token-usage",
    "allow-get-preferences",
    "allow-save-preferences",
    "allow-get-prompts",
    "allow-save-prompt",
    "allow-reset-prompt",
    "allow-preview-prompt",
    "allow-export-data",
    "allow-save-export",
    "allow-import-data",
    "allow-list-operation-log",
    "allow-save-model-settings",
    "allow-clear-api-key",
    "allow-test-model",
    "allow-open-folder",
    "allow-list-backups",
    "allow-create-backup",
    "allow-restore-backup",
    "allow-get-greeting",
    "allow-list-reports",
    "allow-read-report",
    "allow-get-desktop-bootstrap",
    "allow-get-sticky-state",
    "allow-get-sticky-board",
    "allow-update-sticky",
    "allow-close-sticky",
    "allow-create-sticky",
    "allow-set-sticky-task-done",
    "allow-open-main",
    "allow-show-quick-capture",
    "allow-hide-quick-capture",
    "allow-submit-capture",
    "allow-list-input-history",
    "allow-get-ui-copy",
    "allow-suggest-prompt",
    "allow-get-update",
    "allow-get-update-status",
    "allow-check-update",
    "allow-install-update"
  ]
}
