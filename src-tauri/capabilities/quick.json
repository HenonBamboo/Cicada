{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-window",
  "description": "按窗口职责限制可调用命令",
  "windows": [
    "quick"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-desktop-bootstrap",
    "allow-submit-input",
    "allow-confirm-pending",
    "allow-cancel-pending",
    "allow-stop-input",
    "allow-list-inbox",
    "allow-retry-inbox",
    "allow-discard-inbox",
    "allow-resize-quick-capture",
    "allow-hide-quick-capture",
    "allow-open-main",
    "allow-list-input-history",
    "allow-get-ui-copy"
  ]
}
